PORT=5000
NODE_ENV=development

# Optional: If connecting to an external PostgreSQL instance (Docker, local, Supabase, Neon)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Or individual PG variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=attendance_db

# If not provided, embedded PostgreSQL engine (PGlite) runs automatically with persistent storage in .pglite_data!
